{
  "name": "bot",
  "version": "1.0.0",
  "description": "Telegram AI Trading Bot using grammY",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:all": "node dist/start-all.js",
    "start:clean": "node dist/clean-trading-bot.js",
    "start:advanced": "node dist/advanced-trading-bot.js",
    "start:v3": "node dist/bot-v3-start.js",
    "dev": "tsc && node dist/index.js",
    "dev:clean": "tsc && node dist/clean-trading-bot.js",
    "dev:advanced": "tsc && node dist/advanced-trading-bot.js",
    "dev:v3": "tsc && node dist/bot-v3-start.js",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": ["telegram", "bot", "trading", "grammy"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "grammy": "^1.19.2",
    "@grammyjs/conversations": "^1.2.0",
    "@grammyjs/storage-redis": "^2.4.2",
    "@trade/ai": "workspace:*",
    "redis": "^4.6.10",
    "pino": "^8.16.1",
    "pino-pretty": "^10.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  }
}