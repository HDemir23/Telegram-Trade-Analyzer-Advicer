generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  telegramId BigInt  @unique @map("telegram_id")
  username  String?
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chats       Chat[]
  requests    Request[]
  positions   Position[]
  watchlists  Watchlist[]
  alerts      Alert[]

  @@map("users")
}

model Chat {
  id        String   @id @default(cuid())
  telegramId BigInt  @unique @map("telegram_id")
  type      String
  title     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  requests  Request[]

  @@map("chats")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@map("watchlists")
}

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String   @map("watchlist_id")
  symbol      String
  market      String
  createdAt   DateTime @default(now()) @map("created_at")

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@map("watchlist_items")
}

model Request {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  chatId    String   @map("chat_id")
  type      String
  symbol    String
  market    String
  timeframe String
  mode      String?
  status    String   @default("pending")
  params    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  aiOutputs AiOutput[]
  signals   Signal[]

  @@index([symbol, timeframe, createdAt])
  @@map("requests")
}

model AiOutput {
  id        String   @id @default(cuid())
  requestId String   @map("request_id")
  provider  String
  model     String
  prompt    String
  response  Json
  isValid   Boolean  @default(false) @map("is_valid")
  errors    String[]
  tokensIn  Int?     @map("tokens_in")
  tokensOut Int?     @map("tokens_out")
  latencyMs Int?     @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("ai_outputs")
}

model Signal {
  id        String   @id @default(cuid())
  requestId String   @map("request_id")
  symbol    String
  market    String
  timeframe String
  side      String
  entry     Float
  stopLoss  Float    @map("stop_loss")
  takeProfit1 Float? @map("take_profit1")
  takeProfit2 Float? @map("take_profit2")
  positionSize Float @map("position_size")
  leverage  Float?
  confidence Float
  reason    String
  strategy  String
  createdAt DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([symbol, timeframe, createdAt])
  @@map("signals")
}

model Position {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  symbol       String
  market       String
  side         String    // LONG or SHORT
  baseQty      Float     @map("base_qty")
  quoteNotional Float    @map("quote_notional")
  entryPrice   Float     @map("entry_price")
  stopLoss     Float?    @map("stop_loss")
  takeProfit1  Float?    @map("take_profit1")
  takeProfit2  Float?    @map("take_profit2")
  leverage     Float?
  exchange     String?
  note         String?
  status       String    @default("OPEN") // OPEN, CLOSED
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  closedAt     DateTime? @map("closed_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events   PositionEvent[]
  metrics  PositionMetric?

  @@index([userId, status])
  @@map("positions")
}

model PositionEvent {
  id         String   @id @default(cuid())
  positionId String   @map("position_id")
  kind       String   // OPEN, SCALE_IN, SCALE_OUT, SL_HIT, TP_HIT, MANUAL_CLOSE, ADJUST_SL, ADJUST_TP, NOTE
  qtyDelta   Float?   @map("qty_delta")
  price      Float?
  fee        Float?
  note       String?
  timestamp  DateTime @default(now())

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, timestamp])
  @@map("position_events")
}

model PositionMetric {
  id              String   @id @default(cuid())
  positionId      String   @unique @map("position_id")
  lastPrice       Float    @map("last_price")
  unrealizedPnl   Float    @map("unrealized_pnl")
  unrealizedPnlPct Float   @map("unrealized_pnl_pct")
  realizedPnl     Float    @map("realized_pnl")
  maxDdPct        Float    @map("max_dd_pct")
  maxRunupPct     Float    @map("max_runup_pct")
  updatedAt       DateTime @updatedAt @map("updated_at")

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@map("position_metrics")
}

model Backtest {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  strategy  String
  params    Json
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  metrics   Json
  trades    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([symbol, timeframe, strategy])
  @@map("backtests")
}

model Alert {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  symbol    String
  condition Json
  message   String
  isActive  Boolean  @default(true) @map("is_active")
  lastFired DateTime? @map("last_fired")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([symbol, isActive])
  @@map("alerts")
}