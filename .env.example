
# Telegram
TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=

# AI Providers (choose any; routing handles fallbacks)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# ── Market Data: FREE-FIRST DEFAULTS ──────────────────────────────────────
# Crypto (FREE): CoinGecko (no key), Binance (no key)
# Equities/ETFs/Indices (FREE): Yahoo Finance (unofficial, no key)
# Optional FREE/Freemium extras:
FINNHUB_API_KEY=         # optional (freemium: ~60 req/min)
TWELVEDATA_API_KEY=      # optional (freemium)
IEX_CLOUD_TOKEN=         # optional (sandbox/free tier)

# Paid (optional, keep blank for now):
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=

# Provider routing (comma-separated, left→right priority)
# crypto: coingecko,binance,kraken (you can add 'bybit' later)
MARKETDATA_CRYPTO_PROVIDERS=coingecko,binance
# equities: yahoo,finnhub,iex,alphavantage,polygon (yahoo first = free)
MARKETDATA_EQUITY_PROVIDERS=yahoo,finnhub

# Infra
DATABASE_URL=postgresql://user:pass@localhost:5432/tradebot
REDIS_URL=redis://localhost:6379
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Risk & Limits (defaults, overridable in chat /config)
DEFAULT_RISK_PCT=1.0
MAX_LEVERAGE=3
MIN_RR=1.3
DATA_STALENESS_SEC=300
BACKTEST_MAX_YEARS=2

# Analysis & Universe Settings
SCAN_TOP_K=5
SCAN_DEFAULT_MARKETS=crypto,spx,bist
UNIVERSE_CRYPTO=BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,DOTUSDT,LINKUSDT,AVAXUSDT,MATICUSDT,ATOMUSDT,FTMUSDT,NEARUSDT,SUIUSDT,ARUSDT,INJUSDT,APTUSDT,OPUSDT
UNIVERSE_SPX=AAPL,MSFT,GOOGL,TSLA,NVDA,AMZN,META,NFLX,AMD,CRM,ADBE,PYPL,INTC,CSCO,PEP,PLTR,SNOW,COIN,HOOD,SQ
UNIVERSE_BIST=THYAO,AKBNK,GARAN,ISCTR,TUPRS,KCHOL,SAHOL,EREGL,ARCLK,BIMAS,KOZAL,TCELL,PETKM,SISE,KOZAA



